# Bot de pruebas, nunca el token de Umaru.
BOT_TOKEN=
CLIENT_ID=
DISCORD_GUILD_ID=

# MongoDB exclusivo del compose de pruebas.
MONGODB_URI=mongodb://mongo-nukiyasu-test:27017
MONGODB_DB_NAME=nihongotracker_test
MONGODB_COLLECTION_NAME=btv_test
# Sólo para test:integration; apunta al Mongo aislado de este compose.
MONGODB_TEST_URI=mongodb://mongo-nukiyasu-test:27017/nihongotracker_test
MONGODB_TEST_DB_NAME=nihongotracker_test
MONGODB_TEST_COLLECTION=btv_test

# URL de una instancia Nukiyasu de pruebas o de la instancia autorizada para lectura.
# No uses localhost desde el contenedor salvo que hayas configurado explícitamente esa ruta.
NUKIYASU_ENABLED=true
NUKIYASU_URL=
NUKIYASU_USERNAME=
NUKIYASU_PASSWORD=
NUKIYASU_ALLOW_MATURE=false
NUKIYASU_SOCKET_ENABLED=true
NUKIYASU_POLL_INTERVAL_MS=300000
NUKIYASU_STABILIZATION_MS=120000
NUKIYASU_MAX_STABILIZATION_MS=900000
NUKIYASU_MAX_NOTIFICATIONS_PER_RUN=5
NUKIYASU_TIMEOUT_MS=15000
NUKIYASU_MAX_PAGES=1000
# Sólo para una ejecución: reemplaza el snapshot sin crear avisos históricos.
NUKIYASU_REBUILD_BASELINE_ONCE=false
